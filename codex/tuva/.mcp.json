{
  "mcpServers": {
    "tuva": {
      "command": "./scripts/tuva-launch",
      "args": [
        "mcp"
      ],
      "cwd": ".",
      "env": {
        "TUVA_MCP_CLIENT": "codex"
      },
      "env_vars": [
        "TUVA_BACKEND_DIR",
        "TUVA_DATA_DIR",
        "XDG_DATA_HOME",
        "XDG_STATE_HOME",
        "XDG_CONFIG_HOME",
        "TUVA_DAEMON_STATE_PATH",
        "TUVA_PROJECTS_DATA_DIR",
        "TUVA_PROJECTS_DB_PATH",
        "TUVA_SQLITE_JOURNAL_MODE",
        "KNOWLEDGE_INDEX_DIR",
        "MCP_LOG_DIR",
        "TUVA_USAGE_METER",
        "TUVA_SHARED_DATA_DIR",
        "TUVA_AGENT_SESSIONS_DB_PATH",
        "TUVA_CONVERSATIONS_INDEX_PATH",
        "ENTROPY_HOME",
        "LOCALAPPDATA",
        "HF_HOME",
        "HF_HUB_CACHE",
        "SENTENCE_TRANSFORMERS_HOME",
        "SLURM_JOB_ID",
        "PBS_JOBID",
        "LSB_JOBID",
        "JOB_ID",
        "FLUX_JOB_ID"
      ],
      "tool_timeout_sec": 150
    }
  }
}
